# =============================================================================
# SSH Mobile Backend Deployment Environment Configuration (.env)
# =============================================================================

# --- Network & Domains ---
RELAY_PUBLIC_DOMAIN=localhost
RELAY_HTTP_PORT=80
RELAY_HTTPS_PORT=443
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
RELAY_CADDY_IP=172.30.0.10
RELAY_NETWORK_SUBNET=172.30.0.0/24
RELAY_CADDY_IMAGE=caddy:2-alpine

# --- Internal Ports ---
RELAY_INTERNAL_PORT=8080
ADMIN_INTERNAL_PORT=8081
FRONT_INTERNAL_PORT=80

# --- Relay Service Configuration ---
RELAY_PUBLIC_URL=http://localhost
RELAY_ENROLLMENT_TOKEN=replace-with-a-one-time-random-enrollment-secret
RELAY_CREDENTIAL_KEY=replace-with-a-32-byte-base64url-random-key
RELAY_INTERNAL_TOKEN=replace-with-a-32-byte-random-internal-token
RELAY_CREDENTIAL_TTL=24h
RELAY_MAX_CONNECTIONS=2048
RELAY_MAX_ENROLLED_DEVICES=4096
RELAY_MAX_REVOKED_DEVICES=4096
RELAY_MAX_TRANSFER_SESSIONS=4096
RELAY_STORAGE_MODE=memory

# --- Admin Service Configuration ---
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-12-characters
ADMIN_AUTH_KEY=replace-with-a-32-byte-base64url-random-auth-key
ADMIN_SESSION_TTL=24h
ADMIN_MAX_SESSIONS=32
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW=1m
ADMIN_LOGIN_BLOCK=5m
ADMIN_RELAY_URL=http://relay:8080
ADMIN_RELAY_INTERNAL_TOKEN=replace-with-a-32-byte-random-internal-token

# --- Optional Storage Profile (MySQL & Redis) ---
# Start storage profile with: docker compose --profile storage up -d
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=relay
MYSQL_USER=relay
MYSQL_PASSWORD=
RELAY_DATABASE_URL=
RELAY_REDIS_URL=
RELAY_REDIS_PASSWORD=
RELAY_INSTANCE_ID=relay-1
RELAY_PRESENCE_TTL=60s

# --- Analytics / Telemetry (admin-api backend) ---
# The admin-api telemetry ingest writes durable events to analytics-mysql and
# buffers through analytics-redis. Both run under the "storage" profile on the
# isolated internal analytics_state network. Leave TELEMETRY_MYSQL_DSN and
# TELEMETRY_REDIS_URL empty to use the bundled default secrets that match the
# analytics-* container passwords below. TELEMETRY_AUTH_SECRET must be set to a
# random value when telemetry ingest/auth is enabled.
TELEMETRY_MYSQL_DSN=
TELEMETRY_REDIS_URL=
TELEMETRY_AUTH_SECRET=
# Bounded public telemetry ingest controls. The server clamps values to safe
# hard limits; defaults are 1 MiB body, 100 records, 4 DB writers, and a
# 10-request-per-device burst with one token refilled per second.
TELEMETRY_MAX_BODY_BYTES=1048576
TELEMETRY_MAX_BATCH_SIZE=100
TELEMETRY_MAX_CONCURRENT_WRITERS=4
TELEMETRY_RATE_LIMIT_CAPACITY=10
TELEMETRY_RATE_LIMIT_REFILL_PER_SECOND=1
TELEMETRY_RATE_LIMIT_MAX_DEVICES=4096
TELEMETRY_RATE_LIMIT_DEVICE_TTL=10m
TELEMETRY_RETRY_AFTER_SECONDS=1
# Analytics container credentials. The compose defaults must stay in sync with
# the default values used for the TELEMETRY_MYSQL_DSN / TELEMETRY_REDIS_URL
# fallbacks above and with the admin-api service definition in compose.yaml.
ANALYTICS_MYSQL_PASSWORD=replace-with-a-random-database-user-password
ANALYTICS_MYSQL_ROOT_PASSWORD=replace-with-a-random-database-root-password
ANALYTICS_REDIS_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
