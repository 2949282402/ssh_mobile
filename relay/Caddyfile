{
  http_port {$CADDY_HTTP_PORT}
  https_port {$CADDY_HTTPS_PORT}
}

{$RELAY_PUBLIC_DOMAIN} {
  encode zstd gzip

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
  }

  # Keep all device/bootstrap and v2 websocket routes on the Go Relay.  The
  # catch-all below serves the Front SPA, so omitting a route here silently
  # turns an API/WebSocket request into a successful HTML response.
  @relay_api path /api/admin/v1 /api/admin/v1/* /v1 /v1/* /v2 /v2/* /healthz
  handle @relay_api {
    reverse_proxy relay:{$RELAY_INTERNAL_PORT}
  }

  handle {
    reverse_proxy front:{$FRONT_INTERNAL_PORT}
  }
}
