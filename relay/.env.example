# A DNS A/AAAA record for this host must point to the Docker host before Caddy
# can obtain a public certificate. Production uses a bare host with no scheme
# or path; isolated local smoke tests may use an explicit http:// loopback URL.
RELAY_PUBLIC_DOMAIN=relay.example.com
# Public origin advertised in RelayReserveResponse.relay_data_endpoint. Set the
# externally reachable HTTPS/WSS origin; local E2E alone may use loopback HTTP.
RELAY_PUBLIC_URL=

# Host-facing ports and image versions.
RELAY_HTTP_PORT=80
RELAY_HTTPS_PORT=443
RELAY_CADDY_IMAGE=caddy:2.8-alpine

# Internal container ports. Keep these aligned with the service contracts.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
RELAY_INTERNAL_PORT=8080
FRONT_INTERNAL_PORT=80

# Relay runtime limits. Durations use Go time.ParseDuration syntax.
# Storage backend: "memory" (default) or "mysql". mysql enables durable
# enrollment/revocation and requires both RELAY_DATABASE_URL (with
# parseTime=true&loc=UTC) and RELAY_REDIS_URL (the shared state layer).
RELAY_STORAGE_MODE=memory
RELAY_DATABASE_URL=
# Shared state layer (presence, nonce, admin sessions, events); required when
# RELAY_STORAGE_MODE=mysql.
RELAY_REDIS_URL=redis://redis:6379/0
# Required for the storage profile. Generate an independent random value;
# Relay passes it separately so credentials do not appear in the Redis URL.
RELAY_REDIS_PASSWORD=
# Stable per-instance identity for presence; defaults to a random value.
RELAY_INSTANCE_ID=
RELAY_PRESENCE_TTL=60s
# MySQL container credentials (storage compose profile).
MYSQL_ROOT_PASSWORD=replace-with-a-random-database-password
MYSQL_DATABASE=relay
MYSQL_USER=relay
MYSQL_PASSWORD=replace-with-a-random-database-user-password
RELAY_CREDENTIAL_TTL=24h
RELAY_ADMIN_SESSION_TTL=24h
RELAY_MAX_CONNECTIONS=2048
RELAY_MAX_ENROLLED_DEVICES=4096
RELAY_MAX_REVOKED_DEVICES=4096
RELAY_MAX_TRANSFER_SESSIONS=4096
RELAY_MAX_PENDING_FRAMES_PER_DEVICE=64
RELAY_MAX_PENDING_BYTES_PER_DEVICE=16777216
RELAY_MAX_FRAMES_PER_SECOND_PER_DEVICE=256
RELAY_MAX_BYTES_PER_SECOND_PER_DEVICE=67108864
RELAY_MAX_ADMIN_SESSIONS=32
RELAY_ADMIN_LOGIN_MAX_ATTEMPTS=5
RELAY_ADMIN_LOGIN_WINDOW=1m
RELAY_ADMIN_LOGIN_BLOCK=5m
RELAY_MAX_ADMIN_LOGIN_ENTRIES=4096
RELAY_HTTP_READ_TIMEOUT=15s
RELAY_HTTP_WRITE_TIMEOUT=15s
RELAY_HTTP_IDLE_TIMEOUT=60s
RELAY_HTTP_MAX_HEADER_BYTES=16384

# Comma-separated CIDRs whose requests the relay trusts to forward the real
# client address in X-Forwarded-For / X-Real-IP. Empty (the default) never
# honors forwarded headers and uses RemoteAddr directly. In the bundled Compose
# topology this must match the Caddy container's static address in compose.yaml.
RELAY_TRUSTED_PROXY_CIDRS=172.30.0.10/32
# Optional isolated-network overrides for local E2E projects. Keep the defaults
# in sync with the static Caddy address above for normal deployments.
RELAY_NETWORK_SUBNET=172.30.0.0/24
RELAY_CADDY_IP=172.30.0.10

# Create the secrets with a cryptographically secure random generator. Never
# commit the real .env file or reuse these example values.
RELAY_ENROLLMENT_TOKEN=
RELAY_CREDENTIAL_KEY=
RELAY_ADMIN_USER=
RELAY_ADMIN_PASSWORD=
